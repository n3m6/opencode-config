{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "ask",
  "subagent_depth": 4,
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0"
  },
    "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Fusion Proxy (local)",
      "options": {
        "baseURL": "http://localhost:3000/v1"
      },
      "models": {
        "fusion": {
          "name": "fusion:local"
        }
      }
    }
  },
  "experimental":{
    "openTelemetry": false
  },
  "share": "disabled",
  "disabled_providers": ["opencode"],
  "snapshot": false,
  "command": {
    "testfix": {
      "template": "Run the full unit test suite, fix all issues, and then run the full e2e test suite and fix all issues",
      "description": "Run all tests and fix all issues",
      "agent": "build"
    }
  },
  "permission": {
    "external_directory": {
      "~/.config/opencode/**": "allow",
      "/tmp/**": "allow"
    }
  }
}
