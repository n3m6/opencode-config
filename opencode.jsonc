{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "ask",
  "model": "deepseek/deepseek-flash",
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0"
  },
  "providers": {
    // Xiaomi MiMo Token Plan (Singapore). The credential is read from the
    // XIAOMI_TOKEN_PLAN_API_KEY environment variable. Create a token at
    // https://platform.xiaomimimo.com/#/console/plan-manage
    "xiaomi-token-plan-sgp": {
      "env": ["XIAOMI_TOKEN_PLAN_API_KEY"],
      "settings": {}
    }
  },
  "experimental": {
    "openTelemetry": false,
    "subagent_depth": 5
  },
  "share": "disabled",
  "disabled_providers": ["opencode"],
  "snapshot": false,
  "command": {
    "testfix": {
      "template": "Run the full unit test suite, fix all issues, and then run the full e2e test suite and fix all issues",
      "description": "Run all tests and fix all issues",
      "agent": "build"
    }
  },
  "permission": {
    "external_directory": {
      "~/.config/opencode/**": "allow",
      "/tmp/**": "allow"
    }
  }
}
