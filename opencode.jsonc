{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "ask",
  "subagent_depth": 4,
  "model": "deepseek/deepseek-flash",
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0"
  },
  "providers": {
    // Xiaomi MiMo Token Plan (Singapore). Replace the placeholder with the
    // token-plan API key (individual: tp-..., team: ttp-...) from
    // https://platform.xiaomimimo.com/#/console/plan-manage
    "xiaomi-token-plan-sgp": {
      "settings": {
        "apiKey": "***REMOVED***"
      }
    }
  },
  "experimental":{
    "openTelemetry": false
  },
  "share": "disabled",
  "disabled_providers": ["opencode"],
  "snapshot": false,
  "command": {
    "testfix": {
      "template": "Run the full unit test suite, fix all issues, and then run the full e2e test suite and fix all issues",
      "description": "Run all tests and fix all issues",
      "agent": "build"
    }
  },
  "permission": {
    "external_directory": {
      "~/.config/opencode/**": "allow",
      "/tmp/**": "allow"
    }
  }
}
